# Copy to .env and fill in. The Gradle run task reads it, filling gaps only — an exported shell
# variable always wins, so `USE_H2=true ./gradlew :server:run` still overrides what is written here.

# Leave true to run against an in-memory H2 and skip Postgres entirely. Set false and fill the three
# lines below to run against the showcase database.
USE_H2=true

# The showcase Neon project — never the studio one. Neon hands out
# postgresql://user:password@host/db; this wants the JDBC form, with the credentials pulled out.
DATABASE_URL=jdbc:postgresql://<host>/<db>?sslmode=require
DATABASE_USER=
DATABASE_PASSWORD=

# Any non-empty string locally. The deployed server carries its own, and it is not this one.
JWT_SECRET=development-only-secret
JWT_ISSUER=mkdigital-showcase
JWT_AUDIENCE=mkdigital-showcase-users
