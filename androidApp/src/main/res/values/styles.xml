<resources>
    <style name="App.Theme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/neutral_0</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowAnimationStyle">@null</item>

        <!--        status bar-->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="App.Theme.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/App.Theme</item>
    </style>
</resources>
