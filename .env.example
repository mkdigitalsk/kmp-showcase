USE_H2=false
DATABASE_URL=jdbc:postgresql://localhost:5432/kmpshowcase
DATABASE_USER=postgres
DATABASE_PASSWORD=
JWT_SECRET=
JWT_ISSUER=mkdigital-showcase
JWT_AUDIENCE=mkdigital-showcase-users

# The key the web app's proxy presents beside X-Visitor-IP, so the rate limiter counts each visitor rather than
# the platform's egress. Leave it empty locally: no request can then name its own visitor.
PROXY_KEY=
